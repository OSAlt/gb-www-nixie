package templates

templ SocialPage() {
	@Layout("NixiePixel - Social") {
		<nav class="navbar navbar-expand navbar-dark bg-secondary sticky-top sub-nav">
			<div class="container justify-content-center">
				<ul class="navbar-nav">
					<li class="nav-item"><a class="nav-link text-light" href="#social-page">Socials</a></li>
					<li class="nav-item"><a class="nav-link text-light" href="#stats">Stats</a></li>
					<li class="nav-item"><a class="nav-link text-light" href="#media">Media</a></li>
				</ul>
			</div>
		</nav>
		<section id="social-page" class="py-5">
			<div class="container">
				<h1 class="text-white text-center mt-5 mb-5">Socials</h1>
				<div class="row justify-content-center">
					<div class="col-12 col-sm-6 col-lg-3 mb-4">
						<div class="card bg-dark text-light border-secondary h-100 text-center p-4">
							<i class="fab fa-youtube fa-3x text-purple mb-3"></i>
							<h3 class="card-title text-purple">YouTube</h3>
							<a href="https://www.youtube.com/user/nixiedoeslinux" target="_blank" class="btn btn-outline-purple btn-lg mt-3">Visit YouTube</a>
						</div>
					</div>
					<div class="col-12 col-sm-6 col-lg-3 mb-4">
						<div class="card bg-dark text-light border-secondary h-100 text-center p-4">
							<i class="fab fa-twitter fa-3x text-purple mb-3"></i>
							<h3 class="card-title text-purple">Twitter</h3>
							<a href="https://twitter.com/NixiePixel" target="_blank" class="btn btn-outline-purple btn-lg mt-3">Visit Twitter</a>
						</div>
					</div>
					<div class="col-12 col-sm-6 col-lg-3 mb-4">
						<div class="card bg-dark text-light border-secondary h-100 text-center p-4">
							<i class="fab fa-facebook-f fa-3x text-purple mb-3"></i>
							<h3 class="card-title text-purple">Facebook</h3>
							<a href="https://www.facebook.com/nixiepixel" target="_blank" class="btn btn-outline-purple btn-lg mt-3">Visit Facebook</a>
						</div>
					</div>
					<div class="col-12 col-sm-6 col-lg-3 mb-4">
						<div class="card bg-dark text-light border-secondary h-100 text-center p-4">
							<i class="fab fa-instagram fa-3x text-purple mb-3"></i>
							<h3 class="card-title text-purple">Instagram</h3>
							<a href="https://www.instagram.com/nixie.pixel" target="_blank" class="btn btn-outline-purple btn-lg mt-3">Visit Instagram</a>
						</div>
					</div>
					<div class="col-12 col-sm-6 col-lg-3 mb-4">
						<div class="card bg-dark text-light border-secondary h-100 text-center p-4">
							<i class="fab fa-twitch fa-3x text-purple mb-3"></i>
							<h3 class="card-title text-purple">Twitch</h3>
							<a href="https://www.twitch.tv/nixiepixel" target="_blank" class="btn btn-outline-purple btn-lg mt-3">Visit Twitch</a>
						</div>
					</div>
					<div class="col-12 col-sm-6 col-lg-3 mb-4">
						<div class="card bg-dark text-light border-secondary h-100 text-center p-4">
							<i class="fab fa-patreon fa-3x text-purple mb-3"></i>
							<h3 class="card-title text-purple">Patreon</h3>
							<a href="https://www.patreon.com/nixiepixel" target="_blank" class="btn btn-outline-purple btn-lg mt-3">Visit Patreon</a>
						</div>
					</div>
					<div class="col-12 col-sm-6 col-lg-3 mb-4">
						<div class="card bg-dark text-light border-secondary h-100 text-center p-4">
							<i class="fab fa-github fa-3x text-purple mb-3"></i>
							<h3 class="card-title text-purple">GitHub</h3>
							<a href="https://github.com/nixiepixel" target="_blank" class="btn btn-outline-purple btn-lg mt-3">Visit GitHub</a>
						</div>
					</div>
					<div class="col-12 col-sm-6 col-lg-3 mb-4">
						<div class="card bg-dark text-light border-secondary h-100 text-center p-4">
							<i class="fab fa-keybase fa-3x text-purple mb-3"></i>
							<h3 class="card-title text-purple">Keybase</h3>
							<a href="https://keybase.io/nixiepixel" target="_blank" class="btn btn-outline-purple btn-lg mt-3">Visit Keybase</a>
						</div>
					</div>
				</div>
			</div>
		</section>
		<section id="stats" class="pt-5">
			<h1 class="text-white text-center mt-3 mb-4">Some Of My Stats!</h1>
			<p class="text-white text-center mt-3 mb-4">Click/tap a platform to toggle visibility!<br/><span>Hover/tap the llama to view numbers!</span></p>
			<p class="text-white text-center mb-4">
				<label for="llama-hat-select" class="me-2">Dress up the llama:</label>
				<select id="llama-hat-select" autocomplete="off" class="form-select form-select-sm bg-dark text-light border-secondary d-inline-block w-auto">
					<option value="auto">Auto (hat within 5 days of a holiday)</option>
					<option value="none">No hat</option>
					<option value="party">New Year's</option>
					<option value="bow">Valentine's Day</option>
					<option value="tophat">St. Patrick's Day</option>
					<option value="bunny">Easter</option>
					<option value="bandana">Independence Day</option>
					<option value="witch">Halloween</option>
					<option value="pilgrim">Thanksgiving</option>
					<option value="santa">Christmas</option>
				</select>
			</p>
			<div class="position-relative col-10 mx-auto llama-stage">
				<div id="chart" class="h-100 w-100"></div>
				<div id="llama-fx" class="llama-fx"></div>
			</div>
		</section>
		<section id="media" class="pb-4 pt-5">
			<h1 class="text-white text-center mt-3 mb-4">Check Out My Social Feed!</h1>
			<div id="curator-feed-default-feed-layout"><a href="https://curator.io" target="_blank" class="crt-logo crt-tag">Powered by Curator.io</a></div>
			<script type="text/javascript" src="https://cdn.curator.io/published/665652c2-9507-4961-9372-637c95380d14.js" async charset="UTF-8"></script>
		</section>
		<script src="/static/js/llama-fx.js?v=12" defer></script>
	}
}
