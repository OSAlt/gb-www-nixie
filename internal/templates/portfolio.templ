package templates

templ Portfolio() {
	@Layout(
		"Work With Me — Nixie Pixel",
		"Partner with Nixie Pixel: sponsored videos, reviews and integrations for 410,000+ followers, 75% of whom work in tech. Campaigns average a 10% CTR.",
		"/portfolio",
	) {
		<nav class="navbar navbar-expand navbar-dark bg-secondary sticky-top sub-nav">
			<div class="container justify-content-center">
				<ul class="navbar-nav">
					<li class="nav-item"><a class="nav-link text-light" href="#trusted-by">Trusted By Industry Leaders</a></li>
					<li class="nav-item"><a class="nav-link text-light" href="#gbf">GBF</a></li>
					<li class="nav-item"><a class="nav-link text-light" href="#geekbeacon-portfolio">Geekbeacon</a></li>
					<li class="nav-item"><a class="nav-link text-light" href="#product-reviews">Product Reviews</a></li>
					<li class="nav-item"><a class="nav-link text-light" href="#newsletter">Newsletter</a></li>
				</ul>
			</div>
		</nav>
		<section id="portfolio-content" class="py-5">
			<div class="container">
				<div class="page-intro">
					<p class="eyebrow">WORK WITH ME</p>
					<h1 class="page-title">Reach 410,000+ tech buyers.</h1>
					<p class="section-lead">
						I make Linux, gaming and open-source content for people who build, break and buy technology. If your product belongs in that world, let’s put it in front of an audience.
					</p>
					<div class="hero-actions">
						<a class="btn btn-cta" href="/contact">Start a project <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
						<a class="btn btn-ghost" href="#trusted-by">See the results</a>
					</div>
					<ul class="stat-grid" aria-label="Audience and campaign metrics">
						<li><span class="stat-number">410K+</span><span class="stat-label">followers across platforms</span></li>
						<li><span class="stat-number">75%</span><span class="stat-label">of the audience works in tech</span></li>
						<li><span class="stat-number">10%</span><span class="stat-label">average sponsorship CTR</span></li>
					</ul>
				</div>

				<div id="trusted-by" class="mb-5 py-5">
					<h2 class="text-purple border-bottom border-purple pb-2">Trusted By Industry Leaders</h2>
					<p class="mt-3">What happens when brands and open-source organizations collaborate with Nixie Pixel:</p>
					<ul class="text-light mt-3">
						<li><strong>Enterprise &amp; Consumer Tech Partners:</strong> Google, AT&amp;T, Sony, Dell, Ford, Kodak, and Logitech.</li>
						<li><strong>Open-Source, Cloud &amp; Gaming Collaborators:</strong> Linode, ASRock, Techlore, Audible, Skillshare, Ting Mobile, GoDaddy, and Uniformed Gamers, Sourceforge, LANFest Charities, Boys and Girls Club of America Gaming Sector, TinyBuild Publishers</li>
						<li><strong>Conferences &amp; Media Networks:</strong> Former host of <em>OS.ALT</em> and <em>Geekbuzz</em> on <strong>Revision3 (Discovery Digital Networks)</strong>; featured host, speaker, and panelist at <strong>CES</strong> (10-Year Media), <strong>GDC</strong> (10-Year Media), <strong>E3</strong> (8-Year Media), <strong>PAX, Zurich Game Festival, Open Libre Free (OLF) Conference</strong>, and <strong>Southeast LinuxFest (SELF)</strong>.</li>
						<li><strong>Proven Sponsor ROI:</strong> Campaigns average a <strong>10% click-through rate (CTR) on sponsorships</strong> and <strong>4%–8% CTR on display/AdSense</strong> (double the industry average), reaching a network of <strong>410,000+ followers</strong> where <strong>75% of the audience works directly in tech.</strong></li>
					</ul>
					<div class="sponsor-offer">
						<h3 class="text-purple">What we can build together</h3>
						<ul class="offer-grid">
							<li><span class="mono">01</span>Dedicated video review</li>
							<li><span class="mono">02</span>Integrated sponsor segment</li>
							<li><span class="mono">03</span>Hands-on product showcase</li>
							<li><span class="mono">04</span>Livestream &amp; event hosting</li>
							<li><span class="mono">05</span>Short-form &amp; social cutdowns</li>
							<li><span class="mono">06</span>Newsletter placement</li>
						</ul>
					</div>
				</div>

				<div id="gbf" class="mb-5 py-5">
					<h2 class="text-purple border-bottom border-purple pb-2">GBF (GeekBeacon Festival)</h2>
					<p class="mt-3">GeekBeacon Festival is our flagship open-source conference. It brings together developers, enthusiasts, and advocates to share knowledge and build a better future through technology.</p>
				</div>
				<div id="geekbeacon-portfolio" class="mb-5 py-5">
					<h2 class="text-purple border-bottom border-purple pb-2">Geekbeacon</h2>
					<div class="row justify-content-center justify-content-md-around mt-3">
						<div class="col-10 col-md-5 text-center mb-3 mb-md-0 px-0 px-md-3">
							<img src="/static/imgs/cubes.gif" alt="GeekBeacon Cubes" class="img-fluid rounded" width="500" height="500" loading="lazy"/>
						</div>
						<div class="col-10 col-md-5 text-center text-md-start rounded">
							<p class="text-light">
							GeekBeacon is a worldwide community of geeks with a mission focused on building and growing our collective knowledge for the betterment of humanity. In a world with rapidly shifting sociopolitical, economic, and ecological climates we see the marginalized being pushed further to the margins. GeekBeacon strives to make tech and gaming more accessible with projects and research to find new adaptations and innovations. From coding tutorials to community game nights, from chat hangouts to mental health support groups, we draw geeks from all nerddoms together. Sharing information and experiences, guiding one another in creating a collective that strengthens and empowers with an ultimate goal of doing social good.
							</p>
							<p><a href="https://www.geekbeacon.org" target="_blank" rel="noopener" class="btn btn-outline-purple mt-3">Visit GeekBeacon</a></p>
						</div>
					</div>
				</div>
				<div id="product-reviews" class="mb-5 py-5">
					<h2 class="text-purple border-bottom border-purple pb-2">Product Reviews</h2>
					<p class="mt-3"><em>In-depth, honest reviews of technology, software, and gaming gear — tested in the real world with a focus on value, digital privacy, and open-source compatibility.</em></p>
					<ul class="text-light mt-3">
						<li><strong>Hardware, Peripherals &amp; Mobile Tinkering:</strong> Hands-on testing and sponsored showcases featuring PC hardware, laptops, cameras, and gaming peripherals from brands including <strong>Dell, Sony, Logitech, Kodak, and ASRock</strong>, alongside deep dives into emerging open hardware like the <strong>OLPC XO-3 Linux Tablet</strong>, <strong>3D printing with light</strong>, and <strong>Android rooting/custom ROMs vs. iOS</strong> comparisons.</li>
						<li><strong>Linux Distributions &amp; Open-Source OS Reviews:</strong> Approachable, no-fluff evaluations of major and niche operating systems, including <strong>Ubuntu</strong> (from classic <em>Lucid Lynx</em> and <em>Natty Narwhal</em> reviews to modern Ubuntu evaluations), <strong>Fedora, Debian, Arch Linux, and Kali Linux</strong>.</li>
						<li><strong>Privacy, Security &amp; Creator Tools:</strong> Practical evaluations of ethical hacking utilities, ad/tracker blockers (<strong>EFF’s Privacy Badger</strong>), smart-hub data segmentation tools, open-source encryption, and Linux-native creator software like <strong>GUVCviewer</strong>.</li>
						<li><strong>Linux-Compatible Gaming &amp; Indie Spotlights:</strong> Reviews and play-tests focused on native Linux and Steam compatibility, including featured coverage of <em>Danganronpa: Trigger Happy Havoc, Infinifactory, Broforce, Armed and Gelatinous, Hot Lava, and Iron Snout</em> (published via YouTube and <em>OMG! Ubuntu!</em>).</li>
					</ul>
				</div>
				<div id="newsletter" class="mb-5 py-5">
					<h2 class="text-purple border-bottom border-purple pb-2">Newsletter</h2>
					<p class="mt-3">Stay up to date with the latest projects, reviews, and community updates by subscribing to our <a href="https://geekbeacon.org/#/portal" target="_blank" rel="noopener">newsletter</a>.</p>
				</div>
			</div>
		</section>
	}
}
