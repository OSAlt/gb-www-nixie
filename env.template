# Copy to .env (gitignored). Only these two are required.

DATABASE_URL="postgres://nixie:nixie_password@localhost:5432/nixiedb?sslmode=disable"

# Metrika (free) covers every platform on the social chart with one key.
# Sign up: https://metrika.run/users/sign_up  ->  dashboard -> API Tokens
# Free tier: 500 requests/month; the worker spends ~30 (one daily refresh).
METRIKA_API_KEY=""

# --- Optional; the defaults are already correct ---------------------------
# SOCIAL_REFRESH_SECONDS=86400       # refresh cadence (default: daily)
# METRIKA_DISCORD_VANITY=geekbeacon  # only if the server's vanity code changes
#
# The per-platform fallbacks (YOUTUBE_API_KEY, TWITCH_*, DISCORD_*,
# SOCIAL_SCRAPE_URL) are no longer needed: Metrika is the primary source and
# they only fill gaps automatically. Setup, if you ever want them, is in
